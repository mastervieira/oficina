<?xml version="1.0" encoding="UTF-8"?>
<!--
  Falsos positivos do OWASP Dependency-Check. Vazio de propósito: só se acrescenta uma entrada depois de analisar
  o CVE e confirmar que não é alcançável nesta aplicação. Cada <suppress> tem de ter:
    - <notes>: o que é, porque não se aplica aqui, quem decidiu e quando;
    - um <until> (data limite) para a decisão ser revista;
    - o alvo mais estreito possível (<packageUrl> da versão exata + <cve>), nunca uma biblioteca inteira nem
      um <cvssBelow> global.
  Exemplo:
    <suppress until="2027-04-01Z">
      <notes><![CDATA[CVE-XXXX-YYYY: afeta o módulo Z, que não é usado. Analisado por <nome> em AAAA-MM-DD.]]></notes>
      <packageUrl regex="true">^pkg:maven/org\.exemplo/biblioteca@1\.2\.3$</packageUrl>
      <cve>CVE-XXXX-YYYY</cve>
    </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
